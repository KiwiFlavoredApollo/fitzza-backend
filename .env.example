POSTGRES_DB=fitzza
POSTGRES_USER=fitzza
# Required when running product-service directly: export POSTGRES_PASSWORD to match the database.
POSTGRES_PASSWORD=fitzza_local
REDIS_PASSWORD=fitzza_local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-northeast-2
# Required: set a randomly generated secret of at least 32 bytes before starting Compose.
JWT_SECRET=
# Service tokens: each calling service has its own random secret (at least 32 bytes, all different).
# Sent as X-Service-Token. Required: community-service calls user, notification, and product.
COMMUNITY_SERVICE_TOKEN=
# Required: order-service calls product GET /product-options, and product-service accepts this token.
ORDER_SERVICE_TOKEN=
# Optional until recommendation-service calls user body, product measurements, or sends notifications.
RECOMMENDATION_SERVICE_TOKEN=
# Optional until the fitting service sends fitting notifications.
VTON_SERVICE_TOKEN=
# Optional until the fitting service has GET /fittings/{id} and accepts COMMUNITY_SERVICE_TOKEN.
# community-service uses it to check a fitting result before it is shared. In Compose: http://vton-service:8000.
# VTON_SERVICE_URL=http://vton-service:8000
# Optional: TypeSafe Jev key. community-service uses it to judge which vote option a comment supports.
# Leave empty to skip judging (supportedOptionId stays null). Never commit or print the real key.
TYPESAFE_API_KEY=
# Optional until product-service calls another service. Sent as X-Service-Token on those calls.
PRODUCT_SERVICE_TOKEN=
# Required: review-service calls order GET /order-items/{id}, and order-service accepts this token.
REVIEW_SERVICE_TOKEN=
# Optional: Firebase service account key for push notifications (FCM), as base64 of the JSON file
# (e.g. base64 -i key.json | tr -d '\n'). Leave empty to skip push; notifications are still stored.
FIREBASE_CREDENTIALS=
# Optional until recommendation-service has POST /recommendations/size-feedback and accepts REVIEW_SERVICE_TOKEN.
# In Compose: http://recommendation-service:8000. Surveys written while empty are sent later by the retry job.
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8000
# Optional: OpenAI API key and Qdrant endpoint used by recommendation-service.
OPENAI_API_KEY=
QDRANT_URL=http://host.docker.internal:6333
# Access Token: 15 minutes; Refresh Token: 30 days.
# Access Token 유효 기간은 1~900초만 허용합니다.
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=2592000
# Gateway가 호출을 허용할 FE 주소(쉼표로 구분). 비워 두면 아래 기본값을 씁니다.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# 운영 Gateway 프로세스/컨테이너에 SPRING_PROFILES_ACTIVE=prod를 지정하면 문서 라우트와 Swagger가 꺼집니다.
# Compose는 이 값을 자동 전달하지 않으므로 배포 설정에서 Gateway 환경 변수로 지정합니다.

# Refresh Token 쿠키의 Secure 설정. Compose는 이 값을 user-service에 전달합니다.
# 로컬 HTTP 개발의 기본값은 false입니다. 운영 HTTPS 배포에서는 true로 설정해야 합니다.
REFRESH_COOKIE_SECURE=false

# 서비스 전용 DB 계정(선택). 비워 두면 위 POSTGRES_USER/POSTGRES_PASSWORD를 씁니다.
# 계정은 infra/postgres/service-accounts.sql로 만듭니다(README "서비스별 DB 계정" 참고).
# product/order만 따로 쓰려면 infra/postgres/product_order_roles.sql도 가능합니다.
# USER_SERVICE_DB_USER=user_service_app
# USER_SERVICE_DB_PASSWORD=
# PRODUCT_SERVICE_DB_USER=product_service_app
# PRODUCT_SERVICE_DB_PASSWORD=
# ORDER_SERVICE_DB_USER=order_service_app
# ORDER_SERVICE_DB_PASSWORD=
# COMMUNITY_SERVICE_DB_USER=community_service_app
# COMMUNITY_SERVICE_DB_PASSWORD=
# REVIEW_SERVICE_DB_USER=review_service_app
# REVIEW_SERVICE_DB_PASSWORD=
# NOTIFICATION_SERVICE_DB_USER=notification_service_app
# NOTIFICATION_SERVICE_DB_PASSWORD=
