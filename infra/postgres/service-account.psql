-- service-accounts.sql이 서비스마다 불러 쓴다. svc(스키마 이름)와 pw(비밀번호) 변수가 필요하다.
\set role :svc _app
\if :{?pw}
SELECT format('CREATE ROLE %I LOGIN', :'role')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = :'role') \gexec
ALTER ROLE :"role" WITH LOGIN PASSWORD :'pw';
-- RDS 마스터 계정은 슈퍼유저가 아니라서, 소유자를 넘기려면 그 계정의 권한을 받아야 한다(PostgreSQL 16 이상 문법).
GRANT :"role" TO CURRENT_USER WITH INHERIT TRUE, SET TRUE;
GRANT CONNECT ON DATABASE :"DBNAME" TO :"role";
CREATE SCHEMA IF NOT EXISTS :"svc" AUTHORIZATION :"role";
ALTER SCHEMA :"svc" OWNER TO :"role";
-- 관리자 계정으로 만든 기존 테이블(Flyway 기록 테이블 포함)도 서비스 계정 소유로 넘긴다. identity 시퀀스는 테이블을 따라간다.
SELECT format('ALTER TABLE %I.%I OWNER TO %I', schemaname, tablename, :'role')
FROM pg_tables
WHERE schemaname = :'svc' AND tableowner <> :'role' \gexec
\echo :svc 'ready for' :role
\else
\echo :svc 'skipped (password environment variable not set)'
\endif
