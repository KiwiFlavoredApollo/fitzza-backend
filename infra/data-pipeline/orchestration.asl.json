{
  "Comment": "Fitzza data pipeline orchestration. Lambda adapters start and observe the EKS Jobs.",
  "StartAt": "InitializeRun",
  "States": {
    "InitializeRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${InitializeRunLambdaArn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [{ "ErrorEquals": ["States.Timeout", "States.TaskFailed", "Lambda.ServiceException", "Lambda.SdkClientException"], "IntervalSeconds": 10, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "PipelineFailed" }],
      "Next": "RouteRun"
    },
    "RouteRun": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.run_mode", "StringEquals": "integrity", "Next": "RunIntegrityChecks" }],
      "Default": "RunCrawler"
    },
    "RunIntegrityChecks": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${ValidateImportLambdaArn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [{ "ErrorEquals": ["States.Timeout", "States.TaskFailed", "Lambda.ServiceException", "Lambda.SdkClientException"], "IntervalSeconds": 20, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure" }],
      "Next": "RecordSuccess"
    },
    "RunCrawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${CrawlerRunnerLambdaArn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [{ "ErrorEquals": ["States.Timeout", "States.TaskFailed", "Lambda.ServiceException", "Lambda.SdkClientException"], "IntervalSeconds": 30, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure" }],
      "Next": "ValidateAndImport"
    },
    "ValidateAndImport": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${ValidateImportLambdaArn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [{ "ErrorEquals": ["States.Timeout", "States.TaskFailed", "Lambda.ServiceException", "Lambda.SdkClientException"], "IntervalSeconds": 20, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure" }],
      "Next": "RunJev"
    },
    "RunJev": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${JevRunnerLambdaArn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [{ "ErrorEquals": ["States.Timeout", "States.TaskFailed", "Lambda.ServiceException", "Lambda.SdkClientException"], "IntervalSeconds": 60, "MaxAttempts": 3, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure" }],
      "Next": "CheckHumanApproval"
    },
    "CheckHumanApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${ApprovalCheckerLambdaArn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.SdkClientException"], "IntervalSeconds": 10, "MaxAttempts": 3, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure" }],
      "Next": "ApprovalDecision"
    },
    "ApprovalDecision": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.approved", "BooleanEquals": true, "Next": "RunFashionClip" }],
      "Default": "WaitForApproval"
    },
    "WaitForApproval": { "Type": "Wait", "Seconds": 60, "Next": "CheckHumanApproval" },
    "RunFashionClip": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${FashionClipRunnerLambdaArn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [{ "ErrorEquals": ["States.Timeout", "States.TaskFailed", "Lambda.ServiceException", "Lambda.SdkClientException"], "IntervalSeconds": 30, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure" }],
      "Next": "RecordSuccess"
    },
    "RecordSuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${StatusWriterLambdaArn}",
        "Payload": { "status": "SUCCEEDED", "schema_version.$": "$.schema_version", "run_mode.$": "$.run_mode", "run_id.$": "$.run_id", "input_manifest_sha256.$": "$.input_manifest_sha256", "s3.$": "$.s3" }
      },
      "OutputPath": "$.Payload",
      "End": true
    },
    "RecordFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${StatusWriterLambdaArn}",
        "Payload": { "status": "FAILED", "schema_version.$": "$.schema_version", "run_mode.$": "$.run_mode", "run_id.$": "$.run_id", "input_manifest_sha256.$": "$.input_manifest_sha256", "s3.$": "$.s3", "failure.$": "$.failure" }
      },
      "OutputPath": "$.Payload",
      "Next": "PipelineFailed"
    },
    "PipelineFailed": { "Type": "Fail", "Error": "FitzzaDataPipelineFailed", "Cause": "A pipeline stage failed after its configured retries." }
  }
}
