{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Principal": {"Service": "pods.eks.amazonaws.com"},
    "Action": ["sts:AssumeRole", "sts:TagSession"],
    "Condition": {"StringEquals": {
      "aws:RequestTag/eks-cluster-arn": "arn:aws:eks:ap-northeast-2:414901227428:cluster/fitzza-prod",
      "aws:RequestTag/kubernetes-namespace": "fitzza",
      "aws:RequestTag/kubernetes-service-account": "fitzza-indexer"
    }}
  }]
}
